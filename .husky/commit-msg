#!/usr/bin/env sh

# Valida se a mensagem de commit segue o padrão definido no CONTRIBUTING.md
# e no documento oficial do projeto: feat:, fix:, style:, test:, docs:, refactor:
# (chore: liberado também, é o prefixo usado pelo Dependabot).

commit_msg_file="$1"
commit_msg=$(head -n 1 "$commit_msg_file")

pattern="^(feat|fix|style|test|docs|refactor|chore)(\(.*\))?: .{3,}"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "  Mensagem de commit fora do padrão."
  echo ""
  echo "  Recebido: \"$commit_msg\""
  echo ""
  echo "  Use um dos prefixos: feat, fix, style, test, docs, refactor, chore"
  echo "  Exemplos válidos:"
  echo "    feat: adicionar rota de login"
  echo "    fix: corrigir validação de email"
  echo "    test: testes do ProdutoRepository"
  echo ""
  exit 1
fi

exit 0