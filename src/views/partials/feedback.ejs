<div class="feedback" id="feedback-container" aria-live="polite">
    <% if (typeof mensagem !== 'undefined' && mensagem) { %>
        <div class="feedback__item feedback__item--<%= typeof tipoMensagem !== 'undefined' ? tipoMensagem : 'info' %>">
            <%= mensagem %>
        </div>
    <% } %>
</div>
