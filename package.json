{
  "name": "catalogo-Cine-Resenhas",
  "version": "1.0.0",
  "description": "Repositório de Back-end + Web para o projeto *Larp-Flix*, projeto o qual possui o objetivo de catalogar, avaliar e gerenciar filmes e séries diversos. \r   O sistema permite que os usuários explorem produções, filtrem por gênero, façam avaliações com notas e comentários, além de disponibilizar uma área administrativa restrita para gestão de mídias e upload de capas e títulos.",
  "main": "dist/server.js",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fabio-Guilherme-79811/Catalogo-Larp-Flix.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Fabio-Guilherme-79811/Catalogo-Larp-Flix/issues"
  },
  "homepage": "https://github.com/Fabio-Guilherme-79811/Catalogo-Larp-Flix#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.3.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.5",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.15.0"
  }
}
